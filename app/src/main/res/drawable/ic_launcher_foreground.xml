<?xml version="1.0" encoding="utf-8"?>
<!-- Blaylist logo: a golden desert arch opening onto a night of dunes, a crescent moon and a song. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- golden arch (doorway) -->
    <path android:fillColor="#D4A437" android:pathData="M33,84 L33,50 C33,38 43,30 54,22 C65,30 75,38 75,50 L75,84 Z" />
    <!-- sky inside the arch -->
    <path android:pathData="M37,84 L37,51 C37,41 45,34 54,27 C63,34 71,41 71,51 L71,84 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="27"
                android:endX="54" android:endY="84">
                <item android:offset="0" android:color="#FF2A2050" />
                <item android:offset="0.6" android:color="#FF5A2B4C" />
                <item android:offset="1" android:color="#FFC8653A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- crescent moon -->
    <path android:fillColor="#F0CF74"
        android:pathData="M64,34 A7,7 0 1,0 66.5,47.5 A5.6,5.6 0 1,1 64,34 Z" />
    <!-- stars -->
    <path android:fillColor="#F6EBD2"
        android:pathData="M45,37 l0.9,2.1 2.1,0.9 -2.1,0.9 -0.9,2.1 -0.9,-2.1 -2.1,-0.9 2.1,-0.9 Z M58,45 l0.5,1.2 1.2,0.5 -1.2,0.5 -0.5,1.2 -0.5,-1.2 -1.2,-0.5 1.2,-0.5 Z" />
    <!-- far dune -->
    <path android:fillColor="#B9774A"
        android:pathData="M37,73 Q47,66 57,71 Q64,74 71,69 L71,84 L37,84 Z" />
    <!-- near dune -->
    <path android:fillColor="#E2C795"
        android:pathData="M37,79 Q49,72 60,77 Q66,79 71,76 L71,84 L37,84 Z" />
    <!-- music note: the song of the desert -->
    <path android:fillColor="#F0CF74"
        android:pathData="M49.2,44 L51.2,44 L51.2,63 A4.2,3.3 -20 1,1 49.2,60.2 Z" />
    <path android:fillColor="#F0CF74"
        android:pathData="M51.2,44 C55,46 59,48 58,55 C57,51.5 54.5,50 51.2,49.5 Z" />
    <!-- threshold -->
    <path android:fillColor="#D4A437" android:pathData="M29,84 L79,84 L79,87 L29,87 Z" />
</vector>
