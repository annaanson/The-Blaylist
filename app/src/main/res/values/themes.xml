<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: an old desert, parchment by day and indigo by night. -->
    <style name="Base.Theme.Blaylist" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/parchment</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/date_brown</item>
        <item name="colorSurface">@color/parchment</item>
        <item name="colorOnSurface">@color/date_brown</item>
        <item name="android:colorBackground">@color/parchment</item>
        <item name="android:windowBackground">@color/parchment</item>
        <item name="android:fontFamily">@font/amiri_regular</item>
        <item name="fontFamily">@font/amiri_regular</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Blaylist" parent="Base.Theme.Blaylist" />

    <!-- The playing screen lives under the night sky. -->
    <style name="Theme.Blaylist.Night" parent="Theme.Blaylist">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="TextAppearance.Blaylist.Logo" parent="">
        <item name="android:fontFamily">@font/aref_ruqaa_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">@color/terracotta</item>
    </style>

    <style name="TextAppearance.Blaylist.SongTitle" parent="">
        <item name="android:fontFamily">@font/amiri_bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/date_brown</item>
    </style>

    <style name="TextAppearance.Blaylist.SongArtist" parent="">
        <item name="android:fontFamily">@font/amiri_italic</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/brown_muted</item>
    </style>

    <style name="Widget.Blaylist.ControlButton" parent="">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_control_ripple</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/gold_light</item>
    </style>
</resources>
