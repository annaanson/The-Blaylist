<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_parchment"
    tools:context=".MainActivity">

    <!-- Dunes resting at the bottom of the screen, behind the list -->
    <ImageView
        android:id="@+id/dunes"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/dunes_day"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Header -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:includeFontPadding="false"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.Blaylist.Logo"
        app:layout_constraintBottom_toTopOf="@id/app_subtitle"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/logo"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/app_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/amiri_italic"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:text="@string/home_subtitle"
        android:textColor="@color/brown_muted"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/app_title"
        app:layout_constraintTop_toBottomOf="@id/app_title" />

    <ImageView
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="14dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ornament_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <TextView
        android:id="@+id/song_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingBottom="6dp"
        android:fontFamily="@font/amiri_regular"
        android:letterSpacing="0.05"
        android:textColor="@color/terracotta_dark"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        tools:text="12 songs in the caravan" />

    <!-- Song list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/songs_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_list_rise"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="96dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/song_count"
        tools:itemCount="6"
        tools:listitem="@layout/item_song" />

    <!-- Shown when no songs were found -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/song_count"
        app:layout_constraintVertical_bias="0.35"
        tools:visibility="visible">

        <com.example.blaylist.ArchImageView
            android:layout_width="110dp"
            android:layout_height="140dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/art_placeholder"
            app:archStrokeColor="@color/gold"
            app:archStrokeWidth="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/aref_ruqaa_bold"
            android:text="@string/empty_title"
            android:textColor="@color/terracotta"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/amiri_regular"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/empty_message"
            android:textColor="@color/brown_muted"
            android:textSize="15sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
